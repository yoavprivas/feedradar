# PostgreSQL is required. Use a dedicated local database and role.
DATABASE_URL=postgresql://feedradar:CHANGE_ME@127.0.0.1:55432/feedradar
PORT=4310
SCAN_INTERVAL_MINUTES=30
REQUEST_TIMEOUT_MS=12000
MIN_REFRESH_SECONDS=60
HOST=127.0.0.1
AUTH_MODE=local
SCHEDULER_MODE=local
# Cloud: AUTH_MODE=password, SCHEDULER_MODE=external, HOST=0.0.0.0
# PUBLIC_ORIGIN=https://YOUR-SERVICE.run.app
# ADMIN_PASSWORD_HASH=scrypt hash produced by scripts/password-hash.ts (keep secret)
# SCHEDULER_AUDIENCE=https://YOUR-SERVICE.run.app
# SCHEDULER_SERVICE_ACCOUNT=scheduler@YOUR-PROJECT.iam.gserviceaccount.com
# SCHEDULER_JOB_NAME=feedradar-hourly
# DATABASE_CA_FILE=/path/to/provider-ca.pem (only if needed; TLS verification stays enabled)
# Destructive integration tests create/drop an isolated schema in this database.
TEST_DATABASE_URL=postgresql://feedradar:CHANGE_ME@127.0.0.1:55432/feedradar_test
# Compose only: scripts/init-docker.ps1 writes a random value to .env.docker.
# DOCKER_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_HEX_VALUE

# Stage C web service: default sync preserves local development / stage B.
SCAN_MODE=sync
# Set SCAN_MODE=pubsub only after the private worker, IAM and subscriptions are ready.
# PUBSUB_TOPIC=projects/YOUR-PROJECT/topics/feedradar-scans
# Worker uses the same image with: node --import tsx backend/worker-index.ts
# PUBSUB_PUSH_AUDIENCE=https://YOUR-WORKER.run.app
# PUBSUB_PUSH_SERVICE_ACCOUNT=feedradar-push@YOUR-PROJECT.iam.gserviceaccount.com
# PUBSUB_SUBSCRIPTION=projects/YOUR-PROJECT/subscriptions/feedradar-worker
# PUBSUB_DEAD_SUBSCRIPTION=projects/YOUR-PROJECT/subscriptions/feedradar-dead-status
# DATABASE_URL and DATABASE_CA_FILE also apply to the worker (Secret Manager).
# Optional Redis: leave BOTH credentials unset to disable caching. Server-side secrets only.
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=SET_USING_SECRET_MANAGER_NOT_GIT
# CACHE_NAMESPACE=feedradar:YOUR_ENVIRONMENT
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=500
