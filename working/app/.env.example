# PostgreSQL is required. Use a dedicated local database and role.
DATABASE_URL=postgresql://feedradar:CHANGE_ME@127.0.0.1:55432/feedradar
PORT=4310
SCAN_INTERVAL_MINUTES=30
REQUEST_TIMEOUT_MS=12000
MIN_REFRESH_SECONDS=60
# Destructive integration tests create/drop an isolated schema in this database.
TEST_DATABASE_URL=postgresql://feedradar:CHANGE_ME@127.0.0.1:55432/feedradar_test
